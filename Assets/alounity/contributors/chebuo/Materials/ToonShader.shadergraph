    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Light",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void MainLight_float(out float3 Direction, out float3 Color)\r\n{\r\n    #ifdef SHADERGRAPH_PREVIEW\r\n        Direction = float3(0.5, 0.5, 0);\r\n        Color = float3(1,1,1);\r\n    #else\r\n        Light light = GetMainLight();\r\n        Direction = light.direction;\r\n        Color = light.color;\r\n    #endif\r\n}"
}

